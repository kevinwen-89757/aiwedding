NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=production

# Pure local mock mode can leave Supabase empty.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Use mock, manual, or api. api currently supports APIMart.
GENERATION_MODE=manual
GENERATION_PROVIDER=
GOOGLE_GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
GEMINI_MOCK_GENERATION=true

# APIMart Nano Banana Pro generation.
APIMART_API_KEY=
APIMART_BASE_URL=https://api.apimart.ai
APIMART_MODEL=gemini-3-pro-image-preview
APIMART_RESOLUTION=1K
APIMART_TIMEOUT_MS=180000
GENERATION_TEST_LIMIT=1

LOCAL_STORAGE_ROOT=./storage
ADMIN_TOKEN=replace-with-a-long-random-token
