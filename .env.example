NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=production

# Local mode uses ./storage. Netlify production should use STORAGE_DRIVER=supabase.
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ai-wedding-assets

# Use mock, manual, or api. api currently supports APIMart.
GENERATION_MODE=manual
GENERATION_PROVIDER=
GOOGLE_GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
GEMINI_MOCK_GENERATION=true

# APIMart Nano Banana Pro generation.
APIMART_API_KEY=
APIMART_BASE_URL=https://api.apimart.ai
APIMART_MODEL=gemini-3-pro-image-preview
APIMART_RESOLUTION=1K
APIMART_TIMEOUT_MS=300000
GENERATION_TEST_LIMIT=5

ADMIN_TOKEN=replace-with-a-long-random-token
